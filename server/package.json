{
  "name": "multigames-server",
  "version": "1.0.0",
  "description": "Real-time multiplayer mini-games server (Socket.IO engine + pluggable games)",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx test/e2e.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "socket.io-client": "^4.7.5",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
